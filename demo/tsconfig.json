{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "vite/client"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "head-coupled-perspective": [
        "../packages/head-coupled-perspective/src/index.ts"
      ],
      "head-coupled-perspective/three": [
        "../packages/head-coupled-perspective/src/three.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
