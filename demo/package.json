  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "head-coupled-perspective": "*",
    "lil-gui": "^0.21.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  }
