{
  "name": "demo",
  "version": "0.1.0",
  "private": true,
  "description": "Evaluation demo for the head-coupled-perspective library.",
  "type": "module",
  "scripts": {
    "assets": "node scripts/fetch-assets.mjs",
    "predev": "npm run assets",
    "dev": "vite",
    "predev:lan": "npm run assets",
    "dev:lan": "vite --mode lan",
    "follow": "node scripts/follow.mjs",
