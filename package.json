{
  "name": "head-coupled-perspective-workspace",
  "private": true,
  "type": "module",
  "workspaces": ["packages/head-coupled-perspective", "demo"],
  "scripts": {
    "build:lib": "npm run build -w head-coupled-perspective",
    "dev": "npm run build:lib && npm run dev -w demo",
    "dev:lan": "npm run build:lib && npm run dev:lan -w demo",
    "build": "npm run build:lib && npm run build -w demo",
    "test": "npm test -w head-coupled-perspective",
    "typecheck": "npm run typecheck --workspaces"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axeljaeger/head-coupled-perspective.git"
  }
}
